config {
  type: "assertion",
  database: constants.PROJECT_ID,
  schema: constants.SCHEMAS.STAGE,
  description: "Vérifie l'unicité de la clé",
  tags: ["dwh"]
}

SELECT
  key,
  COUNT(*) AS nb_occurrences
FROM ${ref(constants.SCHEMAS.STAGE, "stg_02_customers_prepared")}
GROUP BY key
HAVING COUNT(*) > 1
